# Copy to .env and replace placeholder values.

# Required secrets
BOT_TOKEN=123456789:replace_with_real_telegram_bot_token
GEMINI_API_KEY=replace_with_real_gemini_api_key

# App settings
DATABASE_URL=sqlite+aiosqlite:///./portfolio.db
API_HOST=0.0.0.0
API_PORT=8000
RENDER_EXTERNAL_HOSTNAME=your-service.onrender.com

# Profile data shown by the bot
OWNER_NAME=Your Name
OWNER_TELEGRAM=https://t.me/your_handle
OWNER_GITHUB=https://github.com/your_handle
OWNER_LINKEDIN=https://linkedin.com/in/your_handle
OWNER_VK=https://vk.com/your_handle
